{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"], "env": ["NODE_ENV"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "dependsOn": ["^build"], "persistent": true, "cache": false, "passThroughEnv": ["DATABASE_URL", "PORT", "LOG_LEVEL"] },
    "test:integration": { "cache": false },
    "test:browser": { "cache": false },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false, "passThroughEnv": ["DATABASE_URL"] }
  }
}
