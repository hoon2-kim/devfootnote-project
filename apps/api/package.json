{
  "name": "@devfootnote/api",
  "private": true,
  "version": "0.0.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc-watch --onSuccess 'node ../../scripts/run-env.mjs api dev --watch dist/main.js'",
    "start": "node ../../scripts/run-env.mjs api prod dist/main.js",
    "openapi:generate": "node dist/openapi.js"
  },
  "dependencies": {
    "@devfootnote/ai": "workspace:*",
    "nestjs-cls": "catalog:",
    "@nestjs-cls/transactional": "catalog:",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "catalog:",
    "cookie": "2.0.1",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "zod": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "passport-google-oauth20": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "@devfootnote/db": "workspace:*",
    "@devfootnote/queue": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/passport-google-oauth20": "catalog:",
    "@types/passport-jwt": "catalog:",
    "tsc-watch": "catalog:"
  }
}
