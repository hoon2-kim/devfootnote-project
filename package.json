{
  "name": "devfootnote",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^24.20.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "pnpm build:backend && turbo run typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint . && pnpm format:check && pnpm lint:architecture",
    "format": "eslint . --fix && prettier --write '**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}'",
    "test": "pnpm build:backend && vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "pnpm build:backend && vitest run tests/*.integration.test.ts",
    "test:browser": "playwright test",
    "test:images": "playwright test --config playwright.images.config.ts",
    "bench:search": "pnpm build:api && node tests/benchmarks/keyword-search.mjs",
    "build:api": "turbo run build --filter @devfootnote/api",
    "openapi:generate": "pnpm build:api && pnpm --filter @devfootnote/api openapi:generate && pnpm --filter @devfootnote/api-client generate",
    "openapi:check": "node scripts/check-generated.mjs",
    "db:generate": "pnpm --filter @devfootnote/db db:generate",
    "db:migrate": "pnpm --filter @devfootnote/db db:migrate",
    "db:migrate:prod": "pnpm --filter @devfootnote/db db:migrate:prod",
    "lint:architecture": "depcruise --config .dependency-cruiser.cjs apps/api/src apps/worker/src apps/web/src packages/api-client/src packages/db/src packages/queue/src packages/ai/src",
    "build:backend": "turbo run build --filter @devfootnote/api --filter @devfootnote/worker"
  },
  "devDependencies": {
    "@devfootnote/ai": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.4",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/testing": "catalog:",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "7.2.1",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "dependency-cruiser": "18.3.1",
    "drizzle-orm": "catalog:",
    "eslint": "9.39.4",
    "pg": "catalog:",
    "prettier": "3.9.7",
    "reflect-metadata": "catalog:",
    "supertest": "7.2.2",
    "turbo": "2.10.13",
    "typescript": "catalog:",
    "typescript-eslint": "8.70.0",
    "vitest": "4.0.18",
    "@devfootnote/db": "workspace:*",
    "@devfootnote/queue": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "testcontainers": "catalog:"
  }
}
